<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
// ================================================================
// M1-1: 马克思主义谱系三维地图 (Three.js)
// ================================================================
(function() {
  const canvas = document.getElementById('masters-marx-3d');
  if (!canvas) return;
  const w = canvas.parentElement.clientWidth;
  const h = 500;
  canvas.width = w;
  canvas.height = h;

  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0xF2F0EA);
  const camera = new THREE.PerspectiveCamera(50, w / h, 0.1, 1000);
  camera.position.set(12, 8, 14);
  camera.lookAt(0, 0, 0);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setSize(w, h);
  renderer.setPixelRatio(window.devicePixelRatio);

  // OrbitControls
  let isDragging = false, prevMouse = { x: 0, y: 0 };
  let theta = Math.PI / 4, phi = Math.PI / 5, radius = 18;
  canvas.addEventListener('mousedown', (e) => { isDragging = true; prevMouse = { x: e.clientX, y: e.clientY }; });
  window.addEventListener('mouseup', () => { isDragging = false; });
  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const dx = e.clientX - prevMouse.x, dy = e.clientY - prevMouse.y;
    theta -= dx * 0.01;
    phi = Math.max(0.1, Math.min(Math.PI / 2, phi + dy * 0.01));
    prevMouse = { x: e.clientX, y: e.clientY };
    camera.position.x = radius * Math.sin(phi) * Math.cos(theta);
    camera.position.y = radius * Math.cos(phi);
    camera.position.z = radius * Math.sin(phi) * Math.sin(theta);
    camera.lookAt(0, 0, 0);
  });
  // Scroll zoom
  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    radius = Math.max(8, Math.min(30, radius + e.deltaY * 0.02));
    camera.position.x = radius * Math.sin(phi) * Math.cos(theta);
    camera.position.y = radius * Math.cos(phi);
    camera.position.z = radius * Math.sin(phi) * Math.sin(theta);
    camera.lookAt(0, 0, 0);
  });

  // Axes
  const axesHelper = new THREE.AxesHelper(8);
  scene.add(axesHelper);

  // Grid
  const gridHelper = new THREE.GridHelper(14, 14, 0x4B3FE3, 0xCCCCCC);
  gridHelper.position.y = -4;
  scene.add(gridHelper);

  // Axis labels
  function makeLabel(text, pos, color) {
    const c = document.createElement('canvas');
    c.width = 250; c.height = 48;
    const ctx = c.getContext('2d');
    ctx.clearRect(0, 0, 250, 48);
    ctx.font = 'bold 20px WorkSans, sans-serif';
    ctx.fillStyle = color || '#23211C';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(text, 125, 24);
    const tex = new THREE.CanvasTexture(c);
    const mat = new THREE.SpriteMaterial({ map: tex, depthTest: false });
    const sprite = new THREE.Sprite(mat);
    sprite.position.copy(pos);
    sprite.scale.set(2.2, 0.42, 1);
    scene.add(sprite);
  }
  makeLabel('理论取向', new THREE.Vector3(5, -0.5, 0), '#DC2626');
  makeLabel('时间轴', new THREE.Vector3(0, 5.5, 0), '#2563EB');
  makeLabel('区域轴', new THREE.Vector3(0, -0.5, 5.5), '#16A34A');

  // Data points: [x(理论取向), y(时间), z(区域)]
  // x: -3=经济决定论, 0=中间, 3=文化批判
  // y: -3=19世纪, 0=20世纪中期, 3=21世纪
  // z: -3=西欧, 0=东欧/苏联, 3=中国/全球
  const nodes = [
    { pos: [-2.5, -3.0, -2.0], label: '马克思·恩格斯', color: 0x7C3AED, size: 0.55, group: 'purple' },
    { pos: [-1.5, -1.5, -0.5], label: '列宁', color: 0xDC2626, size: 0.45, group: 'red' },
    { pos: [-1.0, -0.5, 0.5], label: '斯大林', color: 0xBE185D, size: 0.35, group: 'red' },
    { pos: [-0.5, -1.0, 2.0], label: '毛泽东', color: 0xCA8A04, size: 0.45, group: 'red' },
    { pos: [2.0, -2.0, -2.5], label: '卢卡奇', color: 0x7C3AED, size: 0.4, group: 'purple' },
    { pos: [2.5, -1.5, -2.0], label: '葛兰西', color: 0x7C3AED, size: 0.4, group: 'purple' },
    { pos: [3.0, -0.5, -2.5], label: '法兰克福学派', color: 0x7C3AED, size: 0.45, group: 'purple' },
    { pos: [2.0, 0.5, -2.0], label: '哈贝马斯', color: 0x7C3AED, size: 0.4, group: 'purple' },
    { pos: [0.5, -0.5, -2.0], label: '阿尔都塞', color: 0x2563EB, size: 0.4, group: 'blue' },
    { pos: [-1.5, 0.5, -1.0], label: '科恩', color: 0x16A34A, size: 0.35, group: 'green' },
    { pos: [-1.0, 1.0, -1.5], label: '埃尔斯特', color: 0x16A34A, size: 0.35, group: 'green' },
    { pos: [-0.5, 1.0, -1.0], label: '罗默', color: 0x16A34A, size: 0.35, group: 'green' },
    { pos: [1.5, 1.5, 0.5], label: '哈维', color: 0xDC2626, size: 0.4, group: 'red' },
    { pos: [0.5, 2.0, 1.0], label: '福斯特', color: 0x16A34A, size: 0.35, group: 'green' },
    { pos: [1.0, 2.5, 2.0], label: '斯尔尼塞克', color: 0xDC2626, size: 0.35, group: 'red' },
    { pos: [2.5, 2.0, -1.5], label: '拉克劳·墨菲', color: 0xBE185D, size: 0.35, group: 'red' },
    { pos: [0.5, -1.5, 2.5], label: '邓小平', color: 0xCA8A04, size: 0.4, group: 'red' },
    { pos: [1.5, 2.5, 3.0], label: '习近平新时代', color: 0xCA8A04, size: 0.4, group: 'red' },
  ];

  const sphereGeom = new THREE.SphereGeometry(1, 20, 20);
  nodes.forEach(n => {
    const mat = new THREE.MeshStandardMaterial({
      color: n.color,
      emissive: n.color,
      emissiveIntensity: 0.15,
      roughness: 0.3,
      metalness: 0.1
    });
    const sphere = new THREE.Mesh(sphereGeom, mat);
    sphere.position.set(n.pos[0], n.pos[1], n.pos[2]);
    sphere.scale.set(n.size, n.size, n.size);
    scene.add(sphere);

    // Label
    const c = document.createElement('canvas');
    c.width = 300; c.height = 56;
    const ctx = c.getContext('2d');
    ctx.clearRect(0, 0, 300, 56);
    ctx.font = 'bold 19px WorkSans, sans-serif';
    ctx.fillStyle = '#23211C';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(n.label, 150, 28);
    const tex = new THREE.CanvasTexture(c);
    const mat2 = new THREE.SpriteMaterial({ map: tex, depthTest: false });
    const sprite = new THREE.Sprite(mat2);
    sprite.position.set(n.pos[0], n.pos[1] + n.size + 0.6, n.pos[2]);
    sprite.scale.set(1.2, 0.22, 1);
    scene.add(sprite);
  });

  // Connections (lines between related nodes)
  const connections = [
    [0, 1], [0, 4], [0, 5], [1, 2], [1, 3], [3, 16], [16, 17],
    [4, 6], [5, 6], [6, 7], [6, 8], [0, 9], [9, 10], [9, 11],
    [0, 12], [12, 14], [0, 13], [6, 15], [12, 17]
  ];
  connections.forEach(([i, j]) => {
    const p1 = new THREE.Vector3(nodes[i].pos[0], nodes[i].pos[1], nodes[i].pos[2]);
    const p2 = new THREE.Vector3(nodes[j].pos[0], nodes[j].pos[1], nodes[j].pos[2]);
    const mid = new THREE.Vector3().addVectors(p1, p2).multiplyScalar(0.5);
    mid.y += 0.5;
    const curve = new THREE.QuadraticBezierCurve3(p1, mid, p2);
    const pts = curve.getPoints(20);
    const geom = new THREE.BufferGeometry().setFromPoints(pts);
    const mat = new THREE.LineBasicMaterial({ color: 0x4B3FE3, transparent: true, opacity: 0.25 });
    const line = new THREE.Line(geom, mat);
    scene.add(line);
  });

  // Lighting
  const ambient = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambient);
  const dir = new THREE.DirectionalLight(0xffffff, 0.8);
  dir.position.set(5, 10, 5);
  scene.add(dir);
  const dir2 = new THREE.DirectionalLight(0xffffff, 0.3);
  dir2.position.set(-5, 0, -5);
  scene.add(dir2);

  function animate() {
    requestAnimationFrame(animate);
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    const w2 = canvas.parentElement.clientWidth;
    canvas.width = w2; canvas.height = 500;
    camera.aspect = w2 / 500;
    camera.updateProjectionMatrix();
    renderer.setSize(w2, 500);
  });
})();

// ================================================================
// M2-1: 利润率下降趋势模拟 (Chart.js)
// ================================================================
(function() {
  const canvas = document.getElementById('masters-profit-rate-chart');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const parent = canvas.parentElement;
  canvas.width = parent.clientWidth - 30;
  canvas.height = 390;

  const labels = [];
  for (let i = 1; i <= 30; i++) labels.push(i);

  // Marx's original: 剩余价值率不变, c/v提高
  const marxRate = labels.map(x => 1.0 / (x + 1) * 100);

  // Okishio correction: 剩余价值率随技术进步提高
  const okishioRate = labels.map(x => (1.0 + 0.03 * x) / (x + 1) * 100);

  // Counteracting factors zone (upper bound)
  const upperBound = labels.map(x => (1.0 + 0.05 * x) / (x + 1) * 100);

  // Lower bound (accelerated decline)
  const lowerBound = labels.map(x => 0.8 / (x + 1) * 100);

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        {
          label: '马克思原始模型（剩余价值率不变）',
          data: marxRate,
          borderColor: '#2563EB',
          borderWidth: 3,
          pointRadius: 0,
          tension: 0.3,
        },
        {
          label: '置盐修正（剩余价值率随技术进步提高）',
          data: okishioRate,
          borderColor: '#DC2626',
          borderWidth: 3,
          pointRadius: 0,
          tension: 0.3,
          borderDash: [6, 3],
        },
        {
          label: '下降趋势与反趋势的拔河区间（上界）',
          data: upperBound,
          borderColor: 'rgba(220, 38, 38, 0.2)',
          backgroundColor: 'rgba(220, 38, 38, 0.05)',
          borderWidth: 1,
          pointRadius: 0,
          fill: false,
          borderDash: [2, 4],
        },
        {
          label: '下降趋势与反趋势的拔河区间（下界）',
          data: lowerBound,
          borderColor: 'rgba(220, 38, 38, 0.2)',
          backgroundColor: 'rgba(220, 38, 38, 0.05)',
          borderWidth: 1,
          pointRadius: 0,
          fill: '-1',
          borderDash: [2, 4],
        },
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        title: {
          display: true,
          text: '利润率下降趋势的数学模拟：马克思 vs 置盐修正',
          color: '#23211C',
          font: { size: 14, family: 'Lora' }
        },
        legend: {
          labels: { color: '#23211C', font: { size: 10 } },
          position: 'bottom',
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.dataset.label + ': ' + context.parsed.y.toFixed(1) + '%';
            }
          }
        }
      },
      scales: {
        x: {
          title: { display: true, text: '资本有机构成 c/v →', color: '#6E6A60' },
          grid: { color: 'rgba(0,0,0,0.06)' },
          ticks: { color: '#6E6A60' }
        },
        y: {
          title: { display: true, text: '利润率 r (%)', color: '#6E6A60' },
          min: 0,
          max: 100,
          grid: { color: 'rgba(0,0,0,0.06)' },
          ticks: { color: '#6E6A60', callback: function(v) { return v + '%'; } }
        }
      }
    }
  });
})();

// ================================================================
// M4-1: 批判理论方法论谱系图 (Chart.js scatter with labels)
// ================================================================
(function() {
  const canvas = document.getElementById('masters-methodology-chart');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const parent = canvas.parentElement;
  canvas.width = parent.clientWidth - 30;
  canvas.height = 370;

  const methods = [
    { label: '政治经济学批判', x: 0.15, y: 0.8, color: '#DC2626' },
    { label: '意识形态批判', x: 0.35, y: 0.6, color: '#CA8A04' },
    { label: '内在批判', x: 0.5, y: 0.5, color: '#7C3AED' },
    { label: '批判话语分析', x: 0.6, y: 0.35, color: '#0891B2' },
    { label: '结构分析', x: 0.2, y: 0.7, color: '#2563EB' },
    { label: '谱系学', x: 0.7, y: 0.25, color: '#BE185D' },
    { label: '历史唯物主义', x: 0.1, y: 0.75, color: '#4B3FE3' },
    { label: '文化研究', x: 0.8, y: 0.3, color: '#EA580C' },
    { label: '女性主义方法论', x: 0.55, y: 0.15, color: '#16A34A' },
    { label: '后殖民批判', x: 0.75, y: 0.15, color: '#6D28D9' },
    { label: '实证主义', x: 0.15, y: 0.15, color: '#9CA3AF' },
    { label: '诠释学', x: 0.45, y: 0.2, color: '#9CA3AF' },
  ];

  // Arrow connections
  const arrows = [
    [0, 2], [1, 2], [4, 0], [6, 0], [6, 4], [2, 3], [2, 7], [1, 5],
    [3, 8], [5, 9], [2, 8], [2, 9]
  ];

  // Draw arrows on canvas overlay
  // We'll use annotations plugin for arrows, but it's complex, so let's use simpler approach
  new Chart(ctx, {
    type: 'scatter',
    data: {
      datasets: methods.map(m => ({
        label: m.label,
        data: [{ x: m.x, y: m.y }],
        backgroundColor: m.color,
        borderColor: m.color,
        pointRadius: 12,
        pointHoverRadius: 16,
      }))
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        title: {
          display: true,
          text: '批判理论方法论谱系图',
          color: '#23211C',
          font: { size: 14, family: 'Lora' }
        },
        legend: {
          display: false,
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.dataset.label;
            }
          }
        }
      },
      scales: {
        x: {
          title: { display: true, text: '解释 ←——————————→ 批判', color: '#6E6A60' },
          min: 0, max: 1,
          grid: { color: 'rgba(0,0,0,0.06)' },
          ticks: { display: false }
        },
        y: {
          title: { display: true, text: '结构 ←——————————→ 主体', color: '#6E6A60' },
          min: 0, max: 1,
          grid: { color: 'rgba(0,0,0,0.06)' },
          ticks: { display: false }
        }
      }
    },
    plugins: [{
      afterDraw: function(chart) {
        const ctx2 = chart.ctx;
        const meta = chart.getDatasetMeta(0);
        // Draw arrows
        arrows.forEach(([from, to]) => {
          const p1 = meta.data[from].getCenterPoint();
          const p2 = meta.data[to].getCenterPoint();
          ctx2.beginPath();
          ctx2.moveTo(p1.x, p1.y);
          ctx2.lineTo(p2.x, p2.y);
          ctx2.strokeStyle = 'rgba(75, 63, 227, 0.2)';
          ctx2.lineWidth = 1.5;
          ctx2.stroke();
          // Arrowhead
          const angle = Math.atan2(p2.y - p1.y, p2.x - p1.x);
          const headLen = 8;
          ctx2.beginPath();
          ctx2.moveTo(p2.x, p2.y);
          ctx2.lineTo(p2.x - headLen * Math.cos(angle - 0.4), p2.y - headLen * Math.sin(angle - 0.4));
          ctx2.moveTo(p2.x, p2.y);
          ctx2.lineTo(p2.x - headLen * Math.cos(angle + 0.4), p2.y - headLen * Math.sin(angle + 0.4));
          ctx2.strokeStyle = 'rgba(75, 63, 227, 0.35)';
          ctx2.lineWidth = 1.5;
          ctx2.stroke();
        });
        // Draw labels
        const allData = chart.data.datasets;
        allData.forEach((ds, i) => {
          const pt = meta.data[i].getCenterPoint();
          ctx2.fillStyle = '#23211C';
          ctx2.font = 'bold 11px WorkSans, sans-serif';
          ctx2.textAlign = 'center';
          ctx2.fillText(ds.label, pt.x, pt.y - 18);
        });
      }
    }]
  });
})();

// ================================================================
// M5-1: 数字资本主义循环动态 (Canvas animation)
// ================================================================
(function() {
  const canvas = document.getElementById('masters-digital-capitalism');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.parentElement.clientWidth * 0.95;
  const h = 380;
  canvas.width = w;
  canvas.height = h;

  const cx = w / 2, cy = h / 2;
  const radius = Math.min(w, h) * 0.32;

  // Nodes
  const nodes = [
    { label: '用户', color: '#2563EB', angle: -Math.PI / 2, pulse: 0 },
    { label: '数据', color: '#EA580C', angle: -Math.PI / 2 + Math.PI * 2 / 5, pulse: 0 },
    { label: '平台', color: '#DC2626', angle: -Math.PI / 2 + 2 * Math.PI * 2 / 5, pulse: 0 },
    { label: '利润', color: '#16A34A', angle: -Math.PI / 2 + 3 * Math.PI * 2 / 5, pulse: 0 },
    { label: '权力', color: '#7C3AED', angle: -Math.PI / 2 + 4 * Math.PI * 2 / 5, pulse: 0 },
  ];

  let frame = 0;

  function draw() {
    ctx.clearRect(0, 0, w, h);
    const t = frame * 0.02;

    // Update node positions with slight oscillation
    const nodePositions = nodes.map((n, i) => {
      const a = n.angle + Math.sin(t + i * 1.2) * 0.05;
      const r = radius + Math.sin(t * 0.5 + i * 1.5) * 8;
      return {
        x: cx + r * Math.cos(a),
        y: cy + r * Math.sin(a),
        label: n.label,
        color: n.color,
        pulse: (Math.sin(t * 2 + i * 3) + 1) / 2,
      };
    });

    // Draw connections with animated flow
    for (let i = 0; i < nodePositions.length; i++) {
      const j = (i + 1) % nodePositions.length;
      const p1 = nodePositions[i];
      const p2 = nodePositions[j];

      // Flow line
      const flowProgress = (t * 0.3 + i * 0.2) % 1;
      const mx = p1.x + (p2.x - p1.x) * flowProgress;
      const my = p1.y + (p2.y - p1.y) * flowProgress;

      // Line
      ctx.beginPath();
      ctx.moveTo(p1.x, p1.y);
      ctx.lineTo(p2.x, p2.y);
      ctx.strokeStyle = 'rgba(75, 63, 227, 0.2)';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Flow dot
      const grad = ctx.createRadialGradient(mx, my, 0, mx, my, 6);
      grad.addColorStop(0, 'rgba(75, 63, 227, 0.8)');
      grad.addColorStop(1, 'rgba(75, 63, 227, 0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(mx, my, 6, 0, Math.PI * 2);
      ctx.fill();
    }

    // Draw nodes
    nodePositions.forEach(n => {
      // Glow
      const glowSize = 15 + n.pulse * 12;
      const grad = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, glowSize);
      const col = n.color;
      const r = parseInt(col.slice(1, 3), 16);
      const g = parseInt(col.slice(3, 5), 16);
      const b = parseInt(col.slice(5, 7), 16);
      grad.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${0.3 + n.pulse * 0.3})`);
      grad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(n.x, n.y, glowSize, 0, Math.PI * 2);
      ctx.fill();

      // Main circle
      const nodeSize = 22 + n.pulse * 5;
      ctx.fillStyle = n.color;
      ctx.beginPath();
      ctx.arc(n.x, n.y, nodeSize, 0, Math.PI * 2);
      ctx.fill();

      // Border
      ctx.strokeStyle = 'rgba(255,255,255,0.5)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(n.x, n.y, nodeSize, 0, Math.PI * 2);
      ctx.stroke();

      // Label
      ctx.fillStyle = '#FFFFFF';
      ctx.font = 'bold 13px WorkSans, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(n.label, n.x, n.y);
    });

    // Title
    ctx.fillStyle = '#6E6A60';
    ctx.font = '12px WorkSans, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('数字资本主义的自我强化循环：用户 → 数据 → 平台 → 利润 → 权力 → 更多用户', w / 2, 20);

    // Legend
    ctx.fillStyle = '#6E6A60';
    ctx.font = '11px WorkSans, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('● 流动的节点代表数据/资本/权力的循环', 15, h - 15);

    frame++;
    requestAnimationFrame(draw);
  }
  draw();
})();
</script>

<footer>
  <p>马克思主义谱系 · 硕士水平进阶模块 · 2026-09-06 · 总计约9800汉字 · 引用30+学者</p>
