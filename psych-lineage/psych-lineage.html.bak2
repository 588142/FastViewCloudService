          <rect x="162" y="190" width="108" height="24" rx="6" fill="#EFEFF2"/>
          <text x="216" y="207" text-anchor="middle" fill="#52525B" font-size="11" font-family="sans-serif">人本主义</text>
          <rect x="162" y="220" width="108" height="24" rx="6" fill="#EAFBF8" stroke="#27D2BF" stroke-width="1"/>
          <text x="216" y="237" text-anchor="middle" fill="#52525B" font-size="11" font-family="sans-serif">认知革命·生物心理学</text>
          <line x1="216" y1="116" x2="216" y2="130" stroke="#52525B" stroke-width="1" marker-end="url(#arp)"/>
