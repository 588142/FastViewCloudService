          <rect x="162" y="130" width="108" height="24" rx="6" fill="#EFEFF2"/>
          <text x="216" y="147" text-anchor="middle" fill="#52525B" font-size="11" font-family="sans-serif">精神分析</text>
          <rect x="162" y="160" width="108" height="24" rx="6" fill="#EFEFF2"/>
