<script>
(function() {
  const canvas = document.getElementById('viz-psych-3d');
  if (!canvas) return;
  const container = canvas.parentElement;
  const width = container.clientWidth;
  const height = container.clientHeight;

  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0xF0E9F5);

  const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
  camera.position.set(5, 4, 6);
  camera.lookAt(0, 0, 0);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setSize(width, height);
  renderer.setPixelRatio(window.devicePixelRatio || 1);

  // 灯光
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambientLight);
  const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
  dirLight.position.set(5, 10, 7);
  scene.add(dirLight);

  // 坐标轴
  const axesHelper = new THREE.AxesHelper(4);
  scene.add(axesHelper);

  // 网格
  const gridHelper = new THREE.GridHelper(8, 20, 0x6A5E75, 0x6A5E75);
  gridHelper.position.y = -0.01;
  scene.add(gridHelper);

  // 标签（用 Sprite）
  function makeLabel(text, color, position) {
    const canvas2 = document.createElement('canvas');
    canvas2.width = 256;
    canvas2.height = 64;
    const ctx = canvas2.getContext('2d');
    ctx.fillStyle = 'transparent';
    ctx.fillRect(0, 0, 256, 64);
    ctx.font = 'bold 28px "WorkSans", sans-serif';
    ctx.textAlign = 'center';
    ctx.fillStyle = color;
    ctx.fillText(text, 128, 40);
    const texture = new THREE.CanvasTexture(canvas2);
    const material = new THREE.SpriteMaterial({ map: texture, transparent: true });
    const sprite = new THREE.Sprite(material);
    sprite.position.copy(position);
    sprite.scale.set(1.8, 0.45, 1);
    return sprite;
  }
  scene.add(makeLabel('外倾性', '#6D28D9', new THREE.Vector3(4.5, 0, 0)));
  scene.add(makeLabel('宜人性', '#6D28D9', new THREE.Vector3(0, 0, 4.5)));
  scene.add(makeLabel('尽责性', '#B45309', new THREE.Vector3(0, 4.5, 0)));

  // 生成随机点群
  const colors = [0x6D28D9, 0xB45309, 0x2563EB, 0x059669, 0xDC2626];
  const group = new THREE.Group();
  for (let i = 0; i < 120; i++) {
    const x = (Math.random() - 0.5) * 6;
    const z = (Math.random() - 0.5) * 6;
    const y = (Math.random() - 0.5) * 5;
    const color = colors[Math.floor(Math.random() * colors.length)];
    const sphere = new THREE.Mesh(
      new THREE.SphereGeometry(0.12, 12, 12),
      new THREE.MeshPhongMaterial({ color, transparent: true, opacity: 0.7 })
    );
    sphere.position.set(x, y + 0.5, z);
    group.add(sphere);
  }
  scene.add(group);

  // 旋转控制
  let isDragging = false;
  let previousMousePosition = { x: 0, y: 0 };
  let rotationX = 0, rotationY = 0;

  canvas.addEventListener('mousedown', (e) => { isDragging = true; previousMousePosition = { x: e.clientX, y: e.clientY }; });
  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const deltaX = e.clientX - previousMousePosition.x;
    const deltaY = e.clientY - previousMousePosition.y;
    rotationX += deltaY * 0.01;
    rotationY += deltaX * 0.01;
    previousMousePosition = { x: e.clientX, y: e.clientY };
  });
  window.addEventListener('mouseup', () => { isDragging = false; });

  function animate() {
    requestAnimationFrame(animate);
    if (!isDragging) {
      group.rotation.y += 0.003;
    } else {
      group.rotation.x = rotationX;
      group.rotation.y = rotationY;
    }
    renderer.render(scene, camera);
  }
  animate();

  // 响应窗口大小变化
  window.addEventListener('resize', () => {
    const w = container.clientWidth;
    const h = container.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });
})();
</script>

<!-- Chart.js 可视化：ROC 曲线 -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
(function() {
  const ctx = document.getElementById('chart-psych-roc').getContext('2d');
  if (!ctx) return;

  // 生成 ROC 曲线数据
  function generateROC(dPrime) {
    const data = [];
    for (let c = -3; c <= 3; c += 0.05) {
      const hit = 1 - normalCDF(c - dPrime);
      const fa = 1 - normalCDF(c);
      data.push({ x: fa, y: hit });
    }
    return data;
  }

  function normalCDF(x) {
    const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
    const sign = x < 0 ? -1 : 1;
    x = Math.abs(x) / Math.sqrt(2);
    const t = 1 / (1 + p * x);
    const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
    return 0.5 * (1 + sign * y);
  }

  let dPrime = 1.5;
  let rocData = generateROC(dPrime);

  const chart = new Chart(ctx, {
    type: 'scatter',
    data: {
      datasets: [{
        label: 'ROC 曲线 (d\' = ' + dPrime.toFixed(1) + ')',
        data: rocData,
        showLine: true,
        borderColor: '#6D28D9',
        backgroundColor: 'rgba(109,40,217,0.1)',
        pointRadius: 0,
        borderWidth: 2.5,
        fill: true,
        tension: 0.3
      }, {
        label: '机会水平',
        data: [{ x: 0, y: 0 }, { x: 1, y: 1 }],
        showLine: true,
        borderColor: '#6A5E75',
        borderDash: [5, 5],
        pointRadius: 0,
        borderWidth: 1.5
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', labels: { font: { family: 'WorkSans', size: 12 }, color: '#2A2033' } },
        tooltip: { callbacks: { label: (ctx) => `虚报率: ${ctx.parsed.x.toFixed(3)}, 击中率: ${ctx.parsed.y.toFixed(3)}` } }
      },
      scales: {
        x: { title: { display: true, text: '虚报率 P(FA)', font: { family: 'WorkSans', size: 12 } }, min: 0, max: 1, grid: { color: 'rgba(0,0,0,0.06)' } },
        y: { title: { display: true, text: '击中率 P(Hit)', font: { family: 'WorkSans', size: 12 } }, min: 0, max: 1, grid: { color: 'rgba(0,0,0,0.06)' } }
      }
    }
  });

  // 添加滑块控制
  const container = document.getElementById('chart-psych-roc').parentElement;
  const sliderDiv = document.createElement('div');
  sliderDiv.style.cssText = 'display:flex;align-items:center;gap:10px;padding:8px 15px;font-size:0.85rem;color:var(--muted);font-family:var(--font-mono);';
  sliderDiv.innerHTML = '<span>辨别力 d\'：</span><input type="range" id="dprime-slider" min="0.2" max="3.5" step="0.1" value="1.5" style="flex:1;max-width:200px;"> <span id="dprime-value">1.5</span>';
  container.appendChild(sliderDiv);

  document.getElementById('dprime-slider').addEventListener('input', function() {
    dPrime = parseFloat(this.value);
    document.getElementById('dprime-value').textContent = dPrime.toFixed(1);
    rocData = generateROC(dPrime);
    chart.data.datasets[0].data = rocData;
    chart.data.datasets[0].label = 'ROC 曲线 (d\' = ' + dPrime.toFixed(1) + ')';
    chart.update();
  });
})();
</script>

<!-- Chart.js 可视化：学习曲线与遗忘曲线 -->
<script>
(function() {
  const ctx = document.getElementById('chart-psych-learning').getContext('2d');
  if (!ctx) return;

  const learningData = [];
  const forgettingData = [];
  for (let t = 0; t <= 30; t++) {
    // 学习曲线：正确率 = 1 - exp(-0.15 * t)，逐渐逼近1
    const accuracy = 1 - Math.exp(-0.18 * t);
    learningData.push({ x: t, y: accuracy });
    // 遗忘曲线：保留率 = exp(-0.12 * t)
    const retention = Math.exp(-0.12 * t);
    forgettingData.push({ x: t, y: retention });
  }

  const chart = new Chart(ctx, {
    type: 'scatter',
    data: {
      datasets: [{
        label: '学习曲线 (练习次数×正确率)',
        data: learningData,
        showLine: true,
        borderColor: '#2563EB',
        backgroundColor: 'rgba(37,99,235,0.1)',
        pointRadius: 0,
        borderWidth: 2.5,
        fill: true,
        tension: 0.4
      }, {
        label: '遗忘曲线 (艾宾浩斯)',
        data: forgettingData,
        showLine: true,
        borderColor: '#DC2626',
        backgroundColor: 'rgba(220,38,38,0.1)',
        pointRadius: 0,
        borderWidth: 2.5,
        fill: true,
        tension: 0.4,
        borderDash: [5, 5]
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 2000, easing: 'easeOutQuart' },
      plugins: {
        legend: { position: 'bottom', labels: { font: { family: 'WorkSans', size: 11 }, color: '#2A2033' } }
      },
      scales: {
        x: { title: { display: true, text: '时间/练习次数', font: { family: 'WorkSans', size: 12 } }, min: 0, max: 30, grid: { color: 'rgba(0,0,0,0.06)' } },
        y: { title: { display: true, text: '正确率 / 保留率', font: { family: 'WorkSans', size: 12 } }, min: 0, max: 1, grid: { color: 'rgba(0,0,0,0.06)' } }
      }
    }
  });

  // 重播按钮
  const container = document.getElementById('chart-psych-learning').parentElement;
  const btnDiv = document.createElement('div');
  btnDiv.style.cssText = 'text-align:center;padding:6px 0;';
  btnDiv.innerHTML = '<button id="replay-btn" style="padding:6px 18px;border:1px solid var(--accent);border-radius:6px;background:var(--bg);color:var(--accent);font-family:var(--font-mono);font-size:0.82rem;cursor:pointer;">重新播放动画</button>';
  container.appendChild(btnDiv);

  document.getElementById('replay-btn').addEventListener('click', function() {
    chart.reset();
    chart.update();
  });
})();
</script>

<!-- 认知发展阶段动画 Canvas -->
<script>
(function() {
  const canvas = document.getElementById('viz-psych-stages');
  if (!canvas) return;
  const container = canvas.parentElement;
  const w = container.clientWidth;
  const h = container.clientHeight;
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');

  const stages = [
    { name: '感知运动阶段 (0-2岁)', color: '#6D28D9', desc: '通过动作认识世界\n客体永久性' },
    { name: '前运算阶段 (2-7岁)', color: '#7C3AED', desc: '符号功能\n自我中心·不可逆' },
    { name: '具体运算阶段 (7-11岁)', color: '#9333EA', desc: '守恒·分类\n逻辑运算需具体对象' },
    { name: '形式运算阶段 (11岁+)', color: '#A855F7', desc: '抽象思维\n假设演绎·系统推理' }
  ];

  let currentStage = 0;
  let progress = 0;
  let animFrame;

  function draw() {
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#F0E9F5';
    ctx.fillRect(0, 0, w, h);

    // 背景阶梯
    const stageH = (h - 60) / stages.length;
    for (let i = 0; i < stages.length; i++) {
      const y = 30 + i * stageH;
      const isActive = (i === currentStage);
      const isPast = (i < currentStage);

      // 阶梯背景
      ctx.fillStyle = isActive ? 'rgba(109,40,217,0.15)' : (isPast ? 'rgba(109,40,217,0.08)' : 'rgba(0,0,0,0.03)');
      ctx.fillRect(30, y, w - 60, stageH - 5);

      // 阶梯编号
      ctx.fillStyle = isActive ? stages[i].color : (isPast ? '#6A5E75' : '#6A5E75');
      ctx.font = 'bold 14px "WorkSans", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('第' + (i + 1) + '阶段', 90, y + stageH / 2 + 5);

      // 阶段名称
      ctx.fillStyle = isActive ? stages[i].color : (isPast ? '#2A2033' : '#6A5E75');
      ctx.font = (isActive ? 'bold 16px' : '14px') + ' "WorkSans", sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(stages[i].name, 150, y + stageH / 2 - 5);

      // 描述
      ctx.fillStyle = isActive ? '#2A2033' : '#6A5E75';
      ctx.font = '12px "WorkSans", sans-serif';
      const lines = stages[i].desc.split('\n');
      lines.forEach((line, li) => {
        ctx.fillText(line, 150, y + stageH / 2 + 18 + li * 16);
      });

      // 高亮箭头
      if (isActive) {
        ctx.fillStyle = stages[i].color;
        ctx.beginPath();
        const arrowX = w - 50;
        const arrowY = y + stageH / 2;
        ctx.moveTo(arrowX, arrowY - 8);
        ctx.lineTo(arrowX + 12, arrowY);
        ctx.lineTo(arrowX, arrowY + 8);
        ctx.fill();
      }
    }

    // 进度指示器
    const progressWidth = w - 70;
    ctx.fillStyle = 'rgba(0,0,0,0.06)';
    ctx.fillRect(35, h - 20, progressWidth, 6);
    ctx.fillStyle = '#6D28D9';
    ctx.fillRect(35, h - 20, progressWidth * (currentStage + 1) / stages.length, 6);
  }

  function animateStages() {
    currentStage = (currentStage + 1) % stages.length;
    draw();
    setTimeout(animateStages, 3000);
  }

  draw();
  setTimeout(animateStages, 3000);
})();
</script>

<!-- 情绪二维模型 Chart.js -->
<script>
(function() {
  const ctx = document.getElementById('chart-psych-emotion').getContext('2d');
  if (!ctx) return;

  const emotions = [
    { name: '愤怒', x: -0.75, y: 0.85, color: '#DC2626' },
    { name: '恐惧', x: -0.85, y: 0.75, color: '#9333EA' },
    { name: '悲伤', x: -0.6, y: -0.7, color: '#2563EB' },
    { name: '喜悦', x: 0.85, y: 0.8, color: '#059669' },
    { name: '平静', x: 0.7, y: -0.75, color: '#6D28D9' },
    { name: '厌恶', x: -0.7, y: 0.4, color: '#B45309' },
    { name: '惊讶', x: 0.2, y: 0.9, color: '#D97706' }
  ];

  new Chart(ctx, {
    type: 'scatter',
    data: {
      datasets: [{
        label: '基本情绪',
        data: emotions.map(e => ({ x: e.x, y: e.y })),
        backgroundColor: emotions.map(e => e.color),
        pointRadius: 10,
        pointHoverRadius: 14
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: (ctx) => {
              const idx = ctx.dataIndex;
              return emotions[idx].name + ' (效价: ' + emotions[idx].x.toFixed(2) + ', 唤醒度: ' + emotions[idx].y.toFixed(2) + ')';
            }
          }
        }
      },
      scales: {
        x: { title: { display: true, text: '效价 (负面→正面)', font: { family: 'WorkSans', size: 12 } }, min: -1, max: 1, grid: { color: 'rgba(0,0,0,0.06)' } },
        y: { title: { display: true, text: '唤醒度 (低→高)', font: { family: 'WorkSans', size: 12 } }, min: -1, max: 1, grid: { color: 'rgba(0,0,0,0.06)' } }
      }
    },
    plugins: [{
      afterDraw: (chart) => {
        const ctx2 = chart.ctx;
        chart.data.datasets[0].data.forEach((dp, i) => {
          const meta = chart.getDatasetMeta(0);
          const point = meta.data[i];
          ctx2.fillStyle = '#2A2033';
          ctx2.font = 'bold 12px "WorkSans", sans-serif';
          ctx2.textAlign = 'center';
          ctx2.fillText(emotions[i].name, point.x, point.y - 16);
        });
      }
    }]
  });
})();
</script>

