    L4["优点：统一数学与逻辑"]
    L5["缺点：遇到悖论无法解决"]
  end
  PLATO --- FORM --- INTU --- LOGIC
  classDef plato fill:#E0E7FF,stroke:#4338CA,color:#1E1B4B;
  classDef form fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D;
