<!-- Three.js 3D 供需曲面 -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
  var container = document.getElementById('viz-3d-supply-demand');
  if(!container) return;
  var w = container.clientWidth, h = container.clientHeight;
  var scene = new THREE.Scene();
  scene.background = new THREE.Color(0xf8faf6);
  var camera = new THREE.PerspectiveCamera(45, w/h, 0.1, 100);
  camera.position.set(8, 6, 10);
  camera.lookAt(0, 0, 0);
  var renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(w, h);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  // 灯光
  var ambient = new THREE.AmbientLight(0x404040);
  scene.add(ambient);
  var dir = new THREE.DirectionalLight(0xffffff, 0.8);
  dir.position.set(5, 10, 7);
  scene.add(dir);
  var dir2 = new THREE.DirectionalLight(0xffffff, 0.3);
  dir2.position.set(-5, -5, -5);
  scene.add(dir2);

  // 坐标轴
  var axesHelper = new THREE.AxesHelper(6);
  scene.add(axesHelper);

  // 网格
  var gridHelper = new THREE.GridHelper(10, 10, 0x62695C, 0xDFE4D8);
  gridHelper.position.y = -0.1;
  scene.add(gridHelper);

  // 标签用Sprite
  function makeLabel(text, color, pos) {
    var canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 64;
    var ctx = canvas.getContext('2d');
    ctx.fillStyle = color;
    ctx.font = 'bold 20px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(text, 64, 40);
    var tex = new THREE.CanvasTexture(canvas);
    var mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
    var sprite = new THREE.Sprite(mat);
    sprite.position.copy(pos);
    sprite.scale.set(1.5, 0.75, 1);
    scene.add(sprite);
  }
  makeLabel('P', '#B8793B', new THREE.Vector3(0, 6.5, 0));
  makeLabel('Q', '#4F7A28', new THREE.Vector3(6.5, -0.5, 0));
  makeLabel('t', '#62695C', new THREE.Vector3(0, -0.5, 6.5));

  // 需求曲面：蓝色半透明
  var geom = new THREE.BufferGeometry();
  var vertices = [], indices = [];
  var res = 15;
  for(var i=0; i<=res; i++) {
    for(var j=0; j<=res; j++) {
      var t = (i/res)*2 - 1; // -1 to 1 时间
      var q = (j/res)*6 - 3; // 数量
      var p = 5 - 0.6*q + 0.3*t + 0.2*Math.sin(q*0.8) + 0.1*Math.cos(t*2);
      vertices.push(q, Math.max(0.2, p), t*2.5);
    }
  }
  for(var i=0; i<res; i++) {
    for(var j=0; j<res; j++) {
      var a = i*(res+1)+j;
      var b = i*(res+1)+j+1;
      var c = (i+1)*(res+1)+j;
      var d = (i+1)*(res+1)+j+1;
      indices.push(a, b, c);
      indices.push(b, d, c);
    }
  }
  geom.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
  geom.setIndex(indices);
  geom.computeVertexNormals();
  var matDemand = new THREE.MeshPhongMaterial({
    color: 0x4F7A28, transparent: true, opacity: 0.35, side: THREE.DoubleSide, wireframe: false
  });
  var demandMesh = new THREE.Mesh(geom, matDemand);
  scene.add(demandMesh);

  // 供给曲面：橙色半透明
  var geom2 = new THREE.BufferGeometry();
  var vertices2 = [];
  for(var i=0; i<=res; i++) {
    for(var j=0; j<=res; j++) {
      var t = (i/res)*2 - 1;
      var q = (j/res)*6 - 3;
      var p = 1 + 0.5*q + 0.2*t + 0.15*Math.sin(q*0.5+1) + 0.1*Math.cos(t*1.5);
      vertices2.push(q, Math.max(0.2, p), t*2.5);
    }
  }
  geom2.setAttribute('position', new THREE.Float32BufferAttribute(vertices2, 3));
  geom2.setIndex(indices);
  geom2.computeVertexNormals();
  var matSupply = new THREE.MeshPhongMaterial({
    color: 0xB8793B, transparent: true, opacity: 0.35, side: THREE.DoubleSide, wireframe: false
  });
  var supplyMesh = new THREE.Mesh(geom2, matSupply);
  scene.add(supplyMesh);

  // 线框
  var wireMat = new THREE.MeshBasicMaterial({ color: 0x4F7A28, wireframe: true, transparent: true, opacity: 0.15 });
  var wireDemand = new THREE.Mesh(geom, wireMat);
  scene.add(wireDemand);
  var wireMat2 = new THREE.MeshBasicMaterial({ color: 0xB8793B, wireframe: true, transparent: true, opacity: 0.15 });
  var wireSupply = new THREE.Mesh(geom2, wireMat2);
  scene.add(wireSupply);

  // 轨道控制：手动实现旋转
  var angle = 0;
  function animate() {
    requestAnimationFrame(animate);
    angle += 0.003;
    camera.position.x = 10 * Math.sin(angle);
    camera.position.z = 10 * Math.cos(angle);
    camera.lookAt(0, 1, 0);
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', function(){
    var w2 = container.clientWidth, h2 = container.clientHeight;
    camera.aspect = w2/h2;
    camera.updateProjectionMatrix();
    renderer.setSize(w2, h2);
  });
})();
</script>

<!-- Chart.js 函数图 -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
(function(){
  // 生产函数等产量曲线
  var ctx = document.getElementById('chart-production');
  if(!ctx) return;
  var labels = [];
  for(var i=1; i<=20; i++) labels.push(i);
  function isoQ(K, L, A, alpha, beta, Qlevel) {
    // Q = A * L^alpha * K^beta, 固定Q 求K = (Q / (A*L^alpha))^(1/beta)
    var arr = [];
    for(var l=1; l<=20; l++) {
      var k = Math.pow(Qlevel / (A * Math.pow(l, alpha)), 1/beta);
      arr.push(k > 0 ? k : null);
    }
    return arr;
  }
  var A = 1, alpha = 0.4, beta = 0.6;
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        { label: 'Q=10', data: isoQ(1, 1, A, alpha, beta, 10), borderColor: '#4F7A28', borderWidth: 2, tension: 0.3, fill: false, pointRadius: 0 },
        { label: 'Q=15', data: isoQ(1, 1, A, alpha, beta, 15), borderColor: '#B8793B', borderWidth: 2, tension: 0.3, fill: false, pointRadius: 0, borderDash: [5,3] },
        { label: 'Q=20', data: isoQ(1, 1, A, alpha, beta, 20), borderColor: '#62695C', borderWidth: 2, tension: 0.3, fill: false, pointRadius: 0, borderDash: [2,4] }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { font: { size: 12 } } } },
      scales: {
        x: { title: { display: true, text: '劳动 (L)', font: { size: 13 } }, grid: { color: '#DFE4D8' } },
        y: { title: { display: true, text: '资本 (K)', font: { size: 13 } }, grid: { color: '#DFE4D8' } }
      }
    }
  });
})();

(function(){
  // 市场均衡调整动画
  var canvas = document.getElementById('anim-market-equilibrium');
  if(!canvas) return;
  var ctx2 = canvas.getContext('2d');
  var W = canvas.width = canvas.clientWidth;
  var H = canvas.height = canvas.clientHeight;
  var pad = {t: 30, b: 40, l: 50, r: 30};
  var anim = 0;

  function drawEq(t) {
    ctx2.clearRect(0, 0, W, H);
    // 坐标轴
    var x0 = pad.l, y0 = H - pad.b, x1 = W - pad.r, y1 = pad.t;
    ctx2.strokeStyle = '#222820';
    ctx2.lineWidth = 1.5;
    ctx2.beginPath();
    ctx2.moveTo(x0, y0); ctx2.lineTo(x1, y0);
    ctx2.moveTo(x0, y0); ctx2.lineTo(x0, y1);
    ctx2.stroke();
    ctx2.fillStyle = '#62695C';
    ctx2.font = '12px monospace';
    ctx2.textAlign = 'center';
    ctx2.fillText('数量 Q', (x0+x1)/2, H-5);
    ctx2.save();
    ctx2.translate(15, (y0+y1)/2);
    ctx2.rotate(-Math.PI/2);
    ctx2.fillText('价格 P', 0, 0);
    ctx2.restore();

    // 需求曲线（移动）
    var dShift = t * 30;
    ctx2.strokeStyle = '#4F7A28';
    ctx2.lineWidth = 2.5;
    ctx2.beginPath();
    for(var x=x0; x<=x1; x+=1) {
      var q = (x - x0) / (x1 - x0) * 100;
      var p = 100 - 0.8*q + dShift;
      var px = x0 + (q/100)*(x1-x0);
      var py = y0 - (p/120)*(y0-y1);
      if(x===x0) ctx2.moveTo(px, py); else ctx2.lineTo(px, py);
    }
    ctx2.stroke();
    ctx2.fillStyle = '#4F7A28';
    ctx2.font = '12px monospace';
    ctx2.fillText('需求 D' + (t>0.1 ? "'" : ''), x1-60, y0 - (50/120)*(y0-y1)-10);

    // 供给曲线（固定）
    ctx2.strokeStyle = '#B8793B';
    ctx2.lineWidth = 2.5;
    ctx2.beginPath();
    for(var x=x0; x<=x1; x+=1) {
      var q = (x - x0) / (x1 - x0) * 100;
      var p = 10 + 0.6*q;
      var px = x0 + (q/100)*(x1-x0);
      var py = y0 - (p/120)*(y0-y1);
      if(x===x0) ctx2.moveTo(px, py); else ctx2.lineTo(px, py);
    }
    ctx2.stroke();
    ctx2.fillStyle = '#B8793B';
    ctx2.font = '12px monospace';
    ctx2.fillText('供给 S', x1-60, y0 - (80/120)*(y0-y1)-10);

    // 初始均衡点（红色虚线）
    var eq1q = 50, eq1p = 100 - 0.8*50;
    var eq1x = x0 + (eq1q/100)*(x1-x0);
    var eq1y = y0 - (eq1p/120)*(y0-y1);
    ctx2.setLineDash([4,4]);
    ctx2.strokeStyle = '#B03A2E';
    ctx2.lineWidth = 1.5;
    ctx2.beginPath();
    ctx2.moveTo(eq1x, y0); ctx2.lineTo(eq1x, eq1y); ctx2.lineTo(x0, eq1y);
    ctx2.stroke();
    ctx2.setLineDash([]);
    ctx2.fillStyle = '#B03A2E';
    ctx2.beginPath();
    ctx2.arc(eq1x, eq1y, 5, 0, 2*Math.PI);
    ctx2.fill();
    ctx2.font = '10px monospace';
    ctx2.fillText('E₀', eq1x+8, eq1y-5);

    // 新均衡点（绿色虚线）
    var eq2q = 100 - (120 - (10 + 0.6*eq2q)) / 0.8; // 近似
    var eq2q = 58, eq2p = 10 + 0.6*58;
    var eq2x = x0 + (eq2q/100)*(x1-x0);
    var eq2y = y0 - (eq2p/120)*(y0-y1);
    ctx2.setLineDash([4,4]);
    ctx2.strokeStyle = '#14532D';
    ctx2.lineWidth = 1.5;
    ctx2.beginPath();
    ctx2.moveTo(eq2x, y0); ctx2.lineTo(eq2x, eq2y); ctx2.lineTo(x0, eq2y);
    ctx2.stroke();
    ctx2.setLineDash([]);
    ctx2.fillStyle = '#14532D';
    ctx2.beginPath();
    ctx2.arc(eq2x, eq2y, 5, 0, 2*Math.PI);
    ctx2.fill();
    ctx2.font = '10px monospace';
    ctx2.fillText('E₁', eq2x+8, eq2y-5);

    // 箭头标注
    ctx2.fillStyle = '#4F7A28';
    ctx2.font = '11px monospace';
    ctx2.fillText('需求增加 →', x1-120, y0 - (20/120)*(y0-y1)+5);
  }

  function loop() {
    anim += 0.008;
    if(anim > 1) anim = 0;
    var t = Math.abs(Math.sin(anim * Math.PI));
    drawEq(t);
    requestAnimationFrame(loop);
  }
  loop();
})();

(function(){
  // 边际收益与边际成本曲线 (附录四)
  var ctx = document.getElementById('chart-marginal');
  if(!ctx) return;
  var labels = [];
  for(var i=1; i<=20; i++) labels.push(i);
  var mr = [], mc = [];
  for(var i=1; i<=20; i++) {
    mr.push(50 - 2*i);
    mc.push(5 + 0.5*i + 0.03*i*i);
  }
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        { label: 'MR 边际收益', data: mr, borderColor: '#4F7A28', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 },
        { label: 'MC 边际成本', data: mc, borderColor: '#B8793B', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { font: { size: 12 } } } },
      scales: {
        x: { title: { display: true, text: '产量 Q', font: { size: 13 } }, grid: { color: '#DFE4D8' } },
        y: { title: { display: true, text: '成本/收益 (元)', font: { size: 13 } }, grid: { color: '#DFE4D8' } }
      }
    }
  });
})();

(function(){
  // 供需均衡 (附录五)
  var ctx = document.getElementById('chart-equilibrium');
  if(!ctx) return;
  var labels = [];
  for(var i=0; i<=100; i+=5) labels.push(i);
  var d = [], s = [];
  for(var i=0; i<=100; i+=5) {
    d.push(100 - i*0.8);
    s.push(10 + i*0.5);
  }
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        { label: '需求', data: d, borderColor: '#4F7A28', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 },
        { label: '供给', data: s, borderColor: '#B8793B', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { font: { size: 12 } } } },
      scales: {
        x: { title: { display: true, text: '数量 Q', font: { size: 13 } }, grid: { color: '#DFE4D8' } },
        y: { title: { display: true, text: '价格 P', font: { size: 13 } }, grid: { color: '#DFE4D8' } }
      }
    }
  });
})();

(function(){
  // IS-LM 模型 (附录五)
  var ctx = document.getElementById('chart-islm');
  if(!ctx) return;
  var labels = [];
  for(var i=0; i<=20; i++) labels.push(i*100);
  var is = [], lm = [];
  for(var i=0; i<=20; i++) {
    var y = i*100;
    is.push(15 - y/100);
    lm.push(y/100 - 5);
  }
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        { label: 'IS 曲线', data: is, borderColor: '#4F7A28', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 },
        { label: 'LM 曲线', data: lm, borderColor: '#B8793B', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { font: { size: 12 } } } },
      scales: {
        x: { title: { display: true, text: '产出 Y', font: { size: 13 } }, grid: { color: '#DFE4D8' } },
        y: { title: { display: true, text: '利率 r (%)', font: { size: 13 } }, grid: { color: '#DFE4D8' } }
      }
    }
  });
})();

(function(){
  // AD-AS 模型 (附录五)
  var ctx = document.getElementById('chart-adas');
  if(!ctx) return;
  var labels = [];
  for(var i=0; i<=20; i++) labels.push(i*100);
  var ad = [], sras = [], lras = [];
  for(var i=0; i<=20; i++) {
    var y = i*100;
    ad.push(120 - y/10);
    sras.push(20 + y/30);
    lras.push(2000);
  }
  // 调整LRAS为垂直竖线
  var lras2 = [];
  for(var i=0; i<=20; i++) lras2.push(i===0 ? null : null);
  lras2[10] = 20;
  lras2[11] = 120;
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        { label: 'AD 总需求', data: ad, borderColor: '#4F7A28', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 },
        { label: 'SRAS 短期总供给', data: sras, borderColor: '#B8793B', borderWidth: 2.5, tension: 0.3, fill: false, pointRadius: 0 },
        { label: 'LRAS 长期总供给', data: [{x:1200, y:20}, {x:1200, y:120}], borderColor: '#14532D', borderWidth: 2.5, tension: 0, fill: false, pointRadius: 0, showLine: true }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { font: { size: 12 } } } },
      scales: {
        x: { title: { display: true, text: '产出 Y', font: { size: 13 } }, grid: { color: '#DFE4D8' } },
        y: { title: { display: true, text: '价格水平 P', font: { size: 13 } }, grid: { color: '#DFE4D8' } }
      }
    }
  });
})();
</script>

</body>
